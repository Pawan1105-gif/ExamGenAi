NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/examgenai?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-16-chars"
JWT_EXPIRES_IN=7d
# Optional: force provider selection: openai | gemini | ollama | mock
AI_PROVIDER=
# OpenAI (optional): sk-... from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini (optional): AIza... from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; default gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
# Local AI with Ollama (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
CORS_ORIGIN=http://localhost:5173
